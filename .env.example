# --- Server (FastAPI/Python) defaults; copy to .env and edit ---
# NEVER commit a real .env — see .gitignore

# --- Core ---
ZAQORIN_ENV=development
ZAQORIN_LOG_LEVEL=info

# --- API ---
ZAQORIN_API_HOST=0.0.0.0
ZAQORIN_API_PORT=8080
ZAQORIN_API_CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
ZAQORIN_DB_HOST=localhost
ZAQORIN_DB_PORT=5432
ZAQORIN_DB_NAME=zaqorincore
ZAQORIN_DB_USER=zaqorin
ZAQORIN_DB_PASSWORD=changeme
ZAQORIN_DB_POOL_MIN=2
ZAQORIN_DB_POOL_MAX=10

# --- Redis Streams ---
ZAQORIN_REDIS_HOST=localhost
ZAQORIN_REDIS_PORT=6379
ZAQORIN_REDIS_DB=0
# ZAQORIN_REDIS_PASSWORD=

# --- Agent ↔ Server ---
# HMAC-SHA256 secret used to sign agent commands.
# Generate: `openssl rand -hex 32`
ZAQORIN_AGENT_HMAC_SECRET=replace-me-with-32-bytes-of-randomness

# --- Dashboard ---
ZAQORIN_DASHBOARD_URL=http://localhost:5173

# --- Webhooks (optional, for Phase 4+ alerting) ---
# ZAQORIN_TELEGRAM_BOT_TOKEN=
# ZAQORIN_TELEGRAM_CHAT_ID=
# ZAQORIN_WEBHOOK_URL=
