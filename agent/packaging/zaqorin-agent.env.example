# ZaqorinCore Agent — environment variable overrides.
#
# Every value here is ALSO settable in the TOML config file. The env var
# wins when both are set. This file is the right place for secrets
# (e.g. the bearer token) because systemd creates it with mode 0600 by
# convention, while the TOML config is often world-readable after a
# `cp agent.example.toml /etc/zaqorin/agent.toml`.
#
# To enable, uncomment the EnvironmentFile= line in the systemd unit
# and copy this file to /etc/zaqorin/zaqorin-agent.env with mode 0600.

# --- WebSocket endpoint ---
# ZAQORIN_SERVER_URL=wss://zaqorin.example.com:8443/api/v1/events

# --- Stable agent identity ---
# Leave unset to auto-generate a UUID v4 and persist it in
# /var/lib/zaqorin-agent/agent_id. Set to a literal UUID v4 only if
# you are pinning the host's identity across reinstalls.
# ZAQORIN_AGENT_ID=11111111-2222-3333-4444-555555555555

# --- Auth token (Phase 1 optional; Phase 6 will require it) ---
# Sent as `Authorization: Bearer <token>` on the WebSocket upgrade.
# ZAQORIN_AUTH_TOKEN=replace-me-with-a-real-token

# --- Log level ---
# One of: debug, info, warn, error. Invalid values fall back to info
# with a one-line warning at startup.
# ZAQORIN_LOG_LEVEL=info
