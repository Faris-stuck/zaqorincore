# ZaqorinCore Server — environment variable overrides
#
# Every value here is ALSO settable in the TOML config file. The env var
# wins when both are set. Server-side vars use the ZAQORIN_ prefix to
# avoid collision with the agent's vars on the same host.

# --- HTTP server ---
ZAQORIN_SERVER_HOST=0.0.0.0
ZAQORIN_SERVER_PORT=8000

# --- Logging ---
# debug | info | warn | error
ZAQORIN_LOG_LEVEL=info

# --- Database ---
# asyncpg URL. The default expects the docker-compose stack.
# Replace `***` with the real password before any non-dev deploy.
ZAQORIN_DATABASE_URL=postgresql+asyncpg://zaqorin:***@127.0.0.1:25432/zaqorin
# Pool sizing (server-side)
ZAQORIN_DB_POOL_SIZE=5
ZAQORIN_DB_MAX_OVERFLOW=5

# --- Redis ---
# db/0 is fine for a single-tenant install; use db/1, db/2 etc. to
# share a redis with other apps.
ZAQORIN_REDIS_URL=redis://127.0.0.1:6379/0

# --- Streams ---
# Approximate max length of the events stream (XADD MAXLEN ~).
ZAQORIN_STREAM_MAXLEN=10000
# Consumer group name (Phase 3 will read from this).
ZAQORIN_STREAM_GROUP=zaqorin-detectors

# --- CORS allowlist (v3.2.3, F-010) ---
# Comma-separated list of browser origins permitted to call the API.
# Empty (default) = no CORS headers emitted, browsers block cross-origin
# requests (safe default). Set to the operator dashboard origin when
# it lives on a separate domain, e.g.
#   ZAQORIN_API_CORS_ORIGINS=https://console.example.com
ZAQORIN_API_CORS_ORIGINS=

# --- WebSocket DoS hardening (v3.2.3, F-009) ---
# Reject any single WS frame larger than this. Default 1 MiB.
ZAQORIN_WS_MAX_MSG_BYTES=1048576
# Cap the message rate per WS connection (rolling 60s window).
ZAQORIN_WS_MAX_MSG_PER_MIN=100

# --- DNS intel (T1583.001 domain acquisition detection) ---
# RDAP endpoint used by the WHOISRDAPClient stub. Empty = disabled.
# In production point at your chosen RDAP provider, e.g. https://rdap.org/
ZAQORIN_WHOIS_RDAP_URL=
# Comma-separated brand list for typosquat detection. Default applied if unset.
ZAQORIN_PROTECTED_BRANDS=komatsu.co.id,microsoft.com,google.com
